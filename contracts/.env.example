# Copy to .env (never commit it) or store with `npx hardhat keystore set <NAME>`.
# Only needed for --network sepolia; local build/test/deploy need nothing.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<key>
DEPLOYER_PRIVATE_KEY=0x<64-hex-chars>
ETHERSCAN_API_KEY=<etherscan-api-key>
# Public address of the game-server signing key (the private key lives in server/.env only).
# Put it in ignition/parameters/sepolia.json -> RealmForgeModule.signer
SIGNER_ADDRESS=0x0000000000000000000000000000000000000000
