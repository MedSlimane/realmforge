# Copy to .env.local and fill in. All VITE_* vars are exposed to the browser — never put secrets here.

# Chain to target by default: 31337 (hardhat/anvil local) or 11155111 (sepolia)
VITE_DEFAULT_CHAIN_ID=31337
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployed contract addresses (written to .env.local by `npm run deploy:local` at the repo root)
VITE_LEVEL_NFT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_FORGE_COIN_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect Cloud project id (https://cloud.reown.com). Injected wallets (MetaMask) work without it.
VITE_WALLETCONNECT_PROJECT_ID=

# Off-chain services (server/)
VITE_API_URL=http://localhost:8787
VITE_GAME_SERVER_URL=ws://localhost:2567

# IPFS gateway used to resolve level JSON / thumbnails (local dev: the server's own /ipfs/ gateway)
VITE_IPFS_GATEWAY=http://localhost:8787/ipfs/

# Use bundled mock data when the API is unreachable (true/false)
VITE_USE_MOCKS=true
