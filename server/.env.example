# RealmForge server configuration. Copy to .env (never commit .env).

# --- Chain ---
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Deployed contract addresses (leave empty until deployed; the indexer and
# signing endpoints that need them return 503 while unset).
LEVEL_NFT_ADDRESS=
FORGE_COIN_ADDRESS=
# Block to start indexing from on first run (0 = genesis; set to the deploy block on testnets).
INDEXER_START_BLOCK=0

# --- Signer (the trust boundary, see SPEC §2) ---
# !!! PUBLIC TEST KEY — Hardhat/Anvil default account #1
# !!! (address 0x70997970C51812dc3A010C7d01b50e0d17dc79C8). Everybody knows this key.
# !!! Use it ONLY on a local dev chain. Generate a fresh key for any testnet deployment.
SIGNER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# How long a signed proof/result stays valid (seconds) -> EIP-712 `deadline`.
SIGNATURE_TTL_SEC=3600

# --- IPFS ---
# Pinata JWT. Leave empty to store files locally in DATA_DIR/ipfs and return locally computed CIDs.
PINATA_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# --- Servers ---
HOST=0.0.0.0
PORT=8787
GAME_PORT=2567
CORS_ORIGIN=*
DATA_DIR=./data
LOG_LEVEL=info
